name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  build:
    name: Validar y compilar
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Node 22
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - name: Instalar dependencias
        run: npm ci

      - name: Build (valida contenido, genera PDF/OG, compila y pagina)
        run: npm run build
        env:
          PUBLIC_SITE_URL: https://diccionario-ia.vercel.app
