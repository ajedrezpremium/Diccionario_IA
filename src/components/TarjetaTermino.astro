---
import type { TerminoIndice } from '../lib/terminos';
import { CATEGORIAS, NIVELES } from '../lib/categorias';

interface Props {
  termino: TerminoIndice;
  compacta?: boolean;
}

const { termino, compacta = false } = Astro.props;
const categoria = CATEGORIAS[termino.categoria];
const nivel = NIVELES[termino.nivel];
---

<a
  href={`/que-es/${termino.slug}`}
  class="tarjeta group flex h-full flex-col p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-brand/50"
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <span class="chip">{categoria.nombre}</span>
    <span class:list={['etiqueta-nivel', nivel.clase]}>{nivel.nombre}</span>
  </div>
  <h3 class="mt-3 font-display text-xl font-semibold leading-tight tracking-tight group-hover:text-brand">
    {termino.termino}
  </h3>
  <p class:list={['mt-2 text-sm leading-relaxed text-muted', !compacta && 'line-clamp-3']}>
    {termino.definicionCorta}
  </p>
  <span class="mt-auto pt-4 text-sm font-semibold text-brand" aria-hidden="true">
    Ver definición
    <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
  </span>
</a>
