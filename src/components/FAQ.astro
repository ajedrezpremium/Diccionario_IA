---
interface Props {
  faq: Array<{ p: string; r: string }>;
  titulo?: string;
}

const { faq, titulo = 'Preguntas frecuentes' } = Astro.props;
---

<section aria-labelledby="titulo-faq" class="mt-12">
  <h2 id="titulo-faq" class="font-display text-2xl font-semibold tracking-tight">{titulo}</h2>
  <div class="mt-5 divide-y divide-line rounded-2xl border border-line bg-surface">
    {
      faq.map((item) => (
        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold">
            <span>{item.p}</span>
            <svg
              class="h-5 w-5 shrink-0 text-muted transition-transform group-open:rotate-45"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.r}</p>
        </details>
      ))
    }
  </div>
</section>
