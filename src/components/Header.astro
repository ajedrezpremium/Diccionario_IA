---
import { NAV, SITE } from '../lib/site';

const ruta = Astro.url.pathname;
const activo = (href: string) => ruta === href || ruta.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-bg/85 backdrop-blur-md">
  <div class="contenedor flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name}, inicio`}>
      <span
        class="grid h-9 w-9 place-items-center rounded-xl bg-brand font-display text-lg font-bold text-brand-ink"
        aria-hidden="true">IA</span
      >
      <span class="flex flex-col leading-none">
        <span class="font-display text-lg font-semibold tracking-tight">{SITE.name}</span>
        <span class="mt-1 text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-muted"
          >Glosario · {SITE.version}</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Navegación principal">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              activo(item.href)
                ? 'bg-brand-soft text-brand'
                : 'text-muted hover:bg-bg-alt hover:text-ink',
            ]}
            aria-current={activo(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5">
      <a
        href="/buscar"
        class="boton boton-fantasma !px-2.5"
        aria-label="Buscar en el glosario"
        title="Buscar (tecla /)"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>

      <button
        type="button"
        id="boton-tema"
        class="boton boton-fantasma !px-2.5"
        aria-label="Cambiar entre modo claro y oscuro"
        title="Cambiar tema"
      >
        <svg class="block dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <a
        href="/diagnostico"
        class="boton boton-fantasma hidden !px-2.5 sm:inline-flex"
        aria-label="Solicitar diagnóstico gratuito de IA para tu pyme"
        title="Diagnóstico gratuito"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M9 11l3 3L22 4"></path>
          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
        </svg>
      </a>

      <a href="/libro" class="boton boton-primario hidden !px-4 sm:inline-flex">Libro gratis</a>

      <button
        type="button"
        id="boton-menu"
        class="boton boton-fantasma !px-2.5 md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="menu-movil" class="hidden border-t border-line bg-bg md:hidden">
    <nav class="contenedor flex flex-col gap-1 py-3" aria-label="Navegación móvil">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-2.5 text-sm font-medium',
              activo(item.href) ? 'bg-brand-soft text-brand' : 'text-muted hover:bg-bg-alt',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/diagnostico"
        class="rounded-lg px-3 py-2.5 text-sm font-medium text-brand hover:bg-brand-soft"
      >
        Diagnóstico gratuito
      </a>
      <a
        href={SITE.agencyUrl}
        rel="noopener"
        target="_blank"
        class="rounded-lg px-3 py-2.5 text-sm font-medium text-muted hover:bg-bg-alt hover:text-ink"
      >
        Chess AI Agency ↗
      </a>
      <a href="/libro" class="boton boton-primario mt-2">Descargar el libro gratis</a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const botonTema = document.getElementById('boton-tema');
    botonTema?.addEventListener('click', () => {
      const oscuro = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('tema', oscuro ? 'oscuro' : 'claro');
      } catch {}
    });

    const botonMenu = document.getElementById('boton-menu');
    const menu = document.getElementById('menu-movil');
    botonMenu?.addEventListener('click', () => {
      const abierto = menu?.classList.toggle('hidden') === false;
      botonMenu.setAttribute('aria-expanded', String(abierto));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && !/input|textarea|select/i.test(document.activeElement?.tagName || '')) {
        event.preventDefault();
        window.location.href = '/buscar';
      }
    });
  })();
</script>
