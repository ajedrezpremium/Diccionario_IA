---
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length > 2 && (
    <nav aria-label="En esta ficha" class="sticky top-24 hidden lg:block">
      <p class="text-xs font-bold uppercase tracking-[0.12em] text-muted">En esta ficha</p>
      <ul class="mt-3 space-y-2 border-l border-line">
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc={h.slug}
              class="block border-l-2 border-transparent -ml-px pl-3 text-sm leading-snug text-muted transition-colors hover:text-ink data-[activo=true]:border-brand data-[activo=true]:font-semibold data-[activo=true]:text-brand"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/libro"
        class="mt-6 block rounded-xl border border-line bg-surface p-4 text-sm transition-colors hover:border-brand/50"
      >
        <span class="block text-xs font-bold uppercase tracking-[0.1em] text-accent">Gratis</span>
        <span class="mt-1 block font-semibold">Libro de 120 términos en PDF</span>
        <span class="mt-1 block text-xs text-muted">Sin spam. Descarga inmediata.</span>
      </a>
    </nav>
  )
}

<script is:inline>
  (() => {
    const enlaces = document.querySelectorAll('[data-toc]');
    if (!enlaces.length || !('IntersectionObserver' in window)) return;
    const mapa = new Map();
    enlaces.forEach((a) => mapa.set(a.dataset.toc, a));
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (entrada.isIntersecting) {
            enlaces.forEach((a) => a.setAttribute('data-activo', 'false'));
            mapa.get(entrada.target.id)?.setAttribute('data-activo', 'true');
          }
        }
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 },
    );
    document.querySelectorAll('.prosa h2[id]').forEach((h) => observador.observe(h));
  })();
</script>
