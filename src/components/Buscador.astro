---
import { TERMINOS, TOTAL_TERMINOS } from '../lib/terminos';

interface Props {
  grande?: boolean;
  limite?: number;
}

const { grande = false, limite = 8 } = Astro.props;
---

<div class="buscador" data-buscador data-limite={limite}>
  <label for="buscador-input" class="sr-only">Buscar un término de inteligencia artificial</label>
  <div class="relative">
    <svg
      class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
    <input
      id="buscador-input"
      type="search"
      class:list={[
        'campo w-full pl-12 pr-12 shadow-sm',
        grande ? '!py-4 text-base' : '',
      ]}
      placeholder="Busca un término: RAG, agente, token, MCP…"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="buscador-resultados"
      aria-autocomplete="list"
    />
    <kbd
      class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2 rounded border border-line bg-bg-alt px-1.5 py-0.5 font-mono text-[0.65rem] text-muted sm:block"
      >/</kbd
    >
  </div>

  <div
    id="buscador-resultados"
    class="mt-2 hidden overflow-hidden rounded-xl border border-line bg-surface shadow-lg"
    role="listbox"
    aria-label="Resultados del glosario"
  ></div>

  <p class="mt-2 text-xs text-muted">
    {TOTAL_TERMINOS} términos · tolerante a tildes y mayúsculas · sin cookies
  </p>
</div>

<script type="application/json" data-indice-glosario set:html={JSON.stringify(TERMINOS)}></script>

<script>
  type Termino = {
    termino: string;
    slug: string;
    categoria: string;
    nivel: string;
    definicionCorta: string;
    alias: string[];
  };

  const CATS: Record<string, string> = {
    fundamentos: 'Fundamentos',
    modelos: 'Modelos',
    agentes: 'Agentes',
    'herramientas-desarrollo': 'Herramientas',
    'datos-y-conocimiento': 'Datos',
    prompting: 'Prompting',
    'seguridad-y-etica': 'Seguridad',
    negocio: 'Negocio',
  };

  const normalizar = (texto: string) =>
    texto
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();

  const escapar = (texto: string) =>
    texto.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  const iniciar = (contenedor: HTMLElement) => {
    const input = contenedor.querySelector<HTMLInputElement>('#buscador-input');
    const caja = contenedor.querySelector<HTMLElement>('#buscador-resultados');
    const datosEl = document.querySelector<HTMLScriptElement>('[data-indice-glosario]');
    if (!input || !caja || !datosEl) return;

    let terminos: Termino[] = [];
    try {
      terminos = JSON.parse(datosEl.textContent || '[]');
    } catch {
      terminos = [];
    }

    const limite = Number(contenedor.dataset.limite) || 8;
    let activo = -1;

    const buscar = (consulta: string): Termino[] => {
      const q = normalizar(consulta);
      if (!q) return [];
      const palabras = q.split(/\s+/).filter(Boolean);
      return terminos
        .map((t) => {
          const nombre = normalizar(t.termino);
          const alias = normalizar(t.alias.join(' '));
          const def = normalizar(t.definicionCorta);
          let puntos = 0;
          if (nombre === q) puntos += 100;
          if (nombre.startsWith(q)) puntos += 60;
          if (nombre.includes(q)) puntos += 35;
          if (alias.includes(q)) puntos += 20;
          if (def.includes(q)) puntos += 10;
          for (const p of palabras) {
            if (nombre.includes(p)) puntos += 8;
            if (alias.includes(p)) puntos += 4;
            if (def.includes(p)) puntos += 2;
          }
          return { t, puntos };
        })
        .filter((x) => x.puntos > 0)
        .sort((a, b) => b.puntos - a.puntos || a.t.termino.localeCompare(b.t.termino, 'es'))
        .slice(0, limite)
        .map((x) => x.t);
    };

    const pintar = (resultados: Termino[], consulta: string) => {
      activo = -1;
      if (!consulta.trim()) {
        caja.hidden = true;
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      if (resultados.length === 0) {
        caja.innerHTML = `<div class="p-4 text-sm text-muted">
          No hay coincidencias para «${escapar(consulta)}».
          <a class="enlace" href="/buscar?q=${encodeURIComponent(consulta)}">Buscar en todo el contenido</a>
          o <a class="enlace" href="/terminos">ver los 100 términos</a>.
        </div>`;
      } else {
        caja.innerHTML = resultados
          .map(
            (t, i) => `<a href="/que-es/${t.slug}" role="option" data-opcion="${i}" class="flex flex-col gap-1 border-b border-line px-4 py-3 last:border-0 hover:bg-bg-alt focus:bg-bg-alt">
              <span class="flex flex-wrap items-center gap-2">
                <span class="font-semibold">${escapar(t.termino)}</span>
                <span class="chip !py-0 !text-[0.6rem]">${escapar(CATS[t.categoria] || t.categoria)}</span>
              </span>
              <span class="line-clamp-2 text-xs leading-relaxed text-muted">${escapar(t.definicionCorta)}</span>
            </a>`,
          )
          .join('');
      }

      caja.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };

    const mover = (delta: number) => {
      const opciones = Array.from(caja.querySelectorAll<HTMLElement>('[data-opcion]'));
      if (opciones.length === 0) return;
      activo = (activo + delta + opciones.length) % opciones.length;
      opciones.forEach((op, i) => {
        op.classList.toggle('bg-bg-alt', i === activo);
        op.setAttribute('aria-selected', String(i === activo));
      });
      opciones[activo]?.scrollIntoView({ block: 'nearest' });
    };

    input.addEventListener('input', () => pintar(buscar(input.value), input.value));

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        mover(1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        mover(-1);
      } else if (event.key === 'Enter') {
        const opciones = caja.querySelectorAll<HTMLAnchorElement>('[data-opcion]');
        if (activo >= 0 && opciones[activo]) {
          event.preventDefault();
          window.location.href = opciones[activo].href;
        } else if (input.value.trim()) {
          window.location.href = `/buscar?q=${encodeURIComponent(input.value.trim())}`;
        }
      } else if (event.key === 'Escape') {
        caja.hidden = true;
        input.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('click', (event) => {
      if (!contenedor.contains(event.target as Node)) {
        caja.hidden = true;
        input.setAttribute('aria-expanded', 'false');
      }
    });
  };

  document.querySelectorAll<HTMLElement>('[data-buscador]').forEach(iniciar);
</script>
