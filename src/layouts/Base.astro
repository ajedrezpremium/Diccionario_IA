---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AgenteWidget from '../components/AgenteWidget.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  tipo?: string;
  jsonLd?: string[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  canonical = Astro.url.pathname,
  image = '/og/portada.png',
  tipo = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const canonicalAbs = new URL(canonical, SITE.url).toString();
const imageAbs = new URL(image, SITE.url).toString();
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalAbs} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="alternate" hreflang="es" href={canonicalAbs} />
    <link rel="alternate" hreflang="x-default" href={canonicalAbs} />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1013" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalAbs} />
    <meta property="og:image" content={imageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageAbs} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />

    <script is:inline>
      (() => {
        try {
          const guardado = localStorage.getItem('tema');
          const oscuro = guardado
            ? guardado === 'oscuro'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', oscuro);
        } catch {
          /* sin localStorage */
        }
      })();
    </script>

    {jsonLd.map((bloque) => <script type="application/ld+json" set:html={bloque} />)}

    {
      plausible && (
        <script
          defer
          data-domain={plausible}
          src="https://plausible.io/js/script.js"
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:text-brand-ink"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <AgenteWidget />
  </body>
</html>
