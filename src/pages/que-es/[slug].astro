---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Toc from '../../components/Toc.astro';
import FAQ from '../../components/FAQ.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import CtaAgencia from '../../components/CtaAgencia.astro';
import TerminosRelacionados from '../../components/TerminosRelacionados.astro';
import { CATEGORIAS, NIVELES } from '../../lib/categorias';
import { POR_SLUG, vecinos } from '../../lib/terminos';
import { formatearFecha, minutosLectura } from '../../lib/formato';
import { SITE } from '../../lib/site';
import {
  articleJsonLd,
  breadcrumbJsonLd,
  definedTermJsonLd,
  faqJsonLd,
  jsonLd,
} from '../../lib/seo';

export async function getStaticPaths() {
  const terminos = await getCollection('terminos');
  return terminos.map((termino) => ({
    params: { slug: termino.data.slug },
    props: { termino },
  }));
}

const { termino } = Astro.props;
const { Content, headings } = await render(termino);
const datos = termino.data;
const categoria = CATEGORIAS[datos.categoria];
const nivel = NIVELES[datos.nivel];
const indice = POR_SLUG.get(datos.slug);
const { anterior, siguiente } = vecinos(datos.slug);
const minutos = minutosLectura(termino.body ?? '');

const h1 = (() => {
  const n = datos.termino.toLowerCase();
  if (n === 'inteligencia artificial') return 'Qué es la inteligencia artificial';
  if (n.startsWith('ia ')) return `Qué es ${datos.termino}`;
  return `Qué es ${datos.termino} en IA`;
})();

const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Términos', path: '/terminos' },
  { name: datos.termino, path: `/que-es/${datos.slug}` },
];

const bloques = [
  jsonLd(definedTermJsonLd({ ...datos, sinonimos: datos.sinonimos })),
  jsonLd(faqJsonLd(datos.faq)),
  jsonLd(breadcrumbJsonLd(migas)),
  jsonLd(
    articleJsonLd({
      termino: datos.termino,
      slug: datos.slug,
      definicionCorta: datos.definicionCorta,
      actualizado: datos.actualizado,
    }),
  ),
];
---

<Base
  title={datos.metaTitulo}
  description={datos.metaDescripcion}
  canonical={`/que-es/${datos.slug}`}
  image={`/og/${datos.slug}.png`}
  tipo="article"
  jsonLd={bloques}
>
  <div class="contenedor py-6">
    <Breadcrumbs items={migas} />
  </div>

  <div class="contenedor grid gap-12 pb-16 lg:grid-cols-[minmax(0,1fr)_250px] lg:items-start">
    <article>
      <header class="border-b border-line pb-8">
        <div class="flex flex-wrap items-center gap-2">
          <a
            href={`/categorias/${datos.categoria}`}
            class="chip transition-colors hover:border-brand hover:text-brand"
          >
            {categoria.nombre}
          </a>
          <span class:list={['etiqueta-nivel', nivel.clase]}>{nivel.nombre}</span>
          {datos.destacado && <span class="chip">Más consultado</span>}
        </div>

        <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl">
          {h1}
        </h1>
        <p class="mt-4 text-xl leading-relaxed text-muted">{datos.definicionCorta}</p>

        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-muted">
          <span>Por <strong class="font-semibold text-ink">{SITE.author}</strong></span>
          <span aria-hidden="true">·</span>
          <span>Actualizado el {formatearFecha(datos.actualizado)}</span>
          <span aria-hidden="true">·</span>
          <span>{minutos} min de lectura</span>
        </div>

        <div class="mt-8 rounded-xl border border-brand/25 bg-brand-soft/70 p-5">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand">En una frase</p>
          <p class="mt-2 font-display text-xl leading-snug">{datos.definicionCorta}</p>
          {
            datos.sinonimos.length > 0 && (
              <p class="mt-3 text-xs text-muted">
                También se conoce como: {datos.sinonimos.join(', ')}.
              </p>
            )
          }
        </div>
      </header>

      <div class="prosa mt-8">
        <Content />
      </div>

      <div class="mt-12">
        <LeadMagnet
          origen={`ficha-${datos.slug}`}
          compacto
          titulo="Llévate los 100 términos en un PDF"
          texto="La ficha que acabas de leer, junto a otras 99, en un libro ordenado por categorías. Gratis."
        />
      </div>

      <FAQ faq={datos.faq} />

      <TerminosRelacionados slugs={datos.relacionados} />

      <div class="mt-12">
        <CtaAgencia categoria={datos.categoria} />
      </div>

      <nav class="mt-10 grid gap-3 border-t border-line pt-6 sm:grid-cols-2" aria-label="Navegación entre términos">
        {
          anterior ? (
            <a
              href={`/que-es/${anterior.slug}`}
              class="group rounded-xl border border-line p-4 transition-colors hover:border-brand/50"
            >
              <span class="text-xs text-muted">← Anterior</span>
              <span class="mt-1 block font-semibold group-hover:text-brand">{anterior.termino}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          siguiente ? (
            <a
              href={`/que-es/${siguiente.slug}`}
              class="group rounded-xl border border-line p-4 text-right transition-colors hover:border-brand/50"
            >
              <span class="text-xs text-muted">Siguiente →</span>
              <span class="mt-1 block font-semibold group-hover:text-brand">{siguiente.termino}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </article>

    <aside class="hidden lg:block">
      <Toc headings={headings} />
    </aside>
  </div>
</Base>
