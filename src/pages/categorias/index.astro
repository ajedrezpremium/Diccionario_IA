---
import Base from '../../layouts/Base.astro';
import CtaAgencia from '../../components/CtaAgencia.astro';
import { CATEGORIAS, ORDEN_CATEGORIAS } from '../../lib/categorias';
import { contarPorCategoria, terminosDeCategoria } from '../../lib/terminos';
import { SITE } from '../../lib/site';
import { breadcrumbJsonLd, jsonLd } from '../../lib/seo';

const conteos = contarPorCategoria();
const migas = [
  { name: 'Inicio', path: '/' },
  { name: 'Categorías', path: '/categorias' },
];
---

<Base
  title={`Categorías del glosario de IA | ${SITE.name}`}
  description="Las ocho categorías del diccionario: fundamentos, modelos, agentes, herramientas, datos, prompting, seguridad y negocio. Encuentra tu ruta de aprendizaje."
  canonical="/categorias"
  jsonLd={[jsonLd(breadcrumbJsonLd(migas))]}
>
  <header class="border-b border-line bg-bg-alt/40">
    <div class="contenedor py-12 sm:py-16">
      <p class="chip">Rutas de aprendizaje</p>
      <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
        Ocho categorías para no perderte
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        No hace falta saberlo todo. Elige por dónde entrar según lo que necesites resolver: entender
        la base, elegir un modelo, montar un agente o justificar la inversión.
      </p>
    </div>
  </header>

  <div class="contenedor grid gap-5 py-12 sm:grid-cols-2 lg:grid-cols-3">
    {
      ORDEN_CATEGORIAS.map((slug) => {
        const cat = CATEGORIAS[slug];
        const muestra = terminosDeCategoria(slug).slice(0, 3);
        return (
          <a
            href={`/categorias/${slug}`}
            class="tarjeta group flex flex-col p-6 transition-all hover:-translate-y-0.5 hover:border-brand/50"
          >
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-muted">{cat.numero}</span>
              <span class="chip">{conteos[slug]} términos</span>
            </div>
            <h2 class="mt-3 font-display text-2xl font-semibold leading-tight group-hover:text-brand">
              {cat.nombre}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{cat.descripcion}</p>
            <ul class="mt-4 space-y-1 text-sm">
              {muestra.map((t) => (
                <li class="text-muted">
                  <span class="text-brand">→</span> {t.termino}
                </li>
              ))}
            </ul>
            <span class="mt-auto pt-5 text-sm font-semibold text-brand">Entrar en la categoría →</span>
          </a>
        );
      })
    }
  </div>

  <div class="contenedor pb-20">
    <CtaAgencia />
  </div>
</Base>
