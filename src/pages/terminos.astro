---
import Base from '../layouts/Base.astro';
import Buscador from '../components/Buscador.astro';
import TarjetaTermino from '../components/TarjetaTermino.astro';
import CtaAgencia from '../components/CtaAgencia.astro';
import { CATEGORIAS, ORDEN_CATEGORIAS } from '../lib/categorias';
import { TERMINOS, TOTAL_TERMINOS, contarPorCategoria } from '../lib/terminos';
import { SITE } from '../lib/site';
import { breadcrumbJsonLd, jsonLd } from '../lib/seo';

const conteos = contarPorCategoria();
const migas = jsonLd(
  breadcrumbJsonLd([
    { name: 'Inicio', path: '/' },
    { name: 'Términos', path: '/terminos' },
  ]),
);
---

<Base
  title={`Los ${TOTAL_TERMINOS} términos de IA, ordenados | ${SITE.name}`}
  description={`Listado completo de los ${TOTAL_TERMINOS} términos de inteligencia artificial del diccionario, agrupados por categoría y con definición rápida.`}
  canonical="/terminos"
  jsonLd={[migas]}
>
  <header class="border-b border-line bg-bg-alt/40">
    <div class="contenedor py-12 sm:py-16">
      <p class="chip">Glosario completo</p>
      <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
        Los {TOTAL_TERMINOS} términos, de un vistazo
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        Agrupados por categoría para que puedas ir de lo básico a lo aplicado. Si buscas algo
        concreto, escribe en el buscador: funciona con tildes y mayúsculas.
      </p>
      <div class="mt-7 max-w-2xl">
        <Buscador grande limite={10} />
      </div>
    </div>
  </header>

  <nav class="contenedor flex flex-wrap gap-2 py-6" aria-label="Categorías">
    {
      ORDEN_CATEGORIAS.map((slug) => (
        <a
          href={`#${slug}`}
          class="rounded-full border border-line bg-surface px-3 py-1.5 text-xs font-semibold text-muted transition-colors hover:border-brand hover:text-brand"
        >
          {CATEGORIAS[slug].nombre} ({conteos[slug]})
        </a>
      ))
    }
  </nav>

  <div class="contenedor space-y-14 pb-16">
    {
      ORDEN_CATEGORIAS.map((slug) => {
        const cat = CATEGORIAS[slug];
        const lista = TERMINOS.filter((t) => t.categoria === slug);
        return (
          <section id={slug} aria-labelledby={`cat-${slug}`} class="scroll-mt-24">
            <div class="flex flex-wrap items-end justify-between gap-3 border-b border-line pb-3">
              <div>
                <p class="font-mono text-xs text-muted">{cat.numero}</p>
                <h2 id={`cat-${slug}`} class="mt-1 font-display text-2xl font-semibold tracking-tight">
                  {cat.nombre}
                </h2>
              </div>
              <a href={`/categorias/${slug}`} class="text-sm font-semibold text-brand hover:underline">
                Ver categoría →
              </a>
            </div>
            <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {lista.map((t) => <TarjetaTermino termino={t} compacta />)}
            </div>
          </section>
        );
      })
    }
  </div>

  <div class="contenedor pb-20">
    <CtaAgencia />
  </div>
</Base>
