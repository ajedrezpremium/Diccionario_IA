# ============================================================
# Diccionario IA — variables de entorno
# Copia este archivo a .env y rellena los valores.
# En Vercel: Project > Settings > Environment Variables.
# ============================================================

# --- Sitio ---------------------------------------------------
# URL pública final (sin barra final). En local puedes usar http://localhost:4321
PUBLIC_SITE_URL="https://diccionario.ajedrezpremium.com"
PUBLIC_SITE_NAME="Diccionario IA"

# --- Agente IA (elige proveedor) -----------------------------
# groq | openrouter
AI_PROVIDER="groq"

# Modelo exacto del proveedor. Se puede cambiar sin tocar código.
# Groq:       openai/gpt-oss-120b  |  qwen/qwen3.8-27b
# OpenRouter: meta-llama/llama-3.3-70b-instruct:free  |  google/gemini-2.5-flash
AI_MODEL="openai/gpt-oss-120b"

# Claves (solo servidor; NUNCA con prefijo PUBLIC_)
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Opcionales
AI_MAX_TOKENS="700"
AI_TEMPERATURE="0.4"
RATE_LIMIT_PER_MIN="12"
RATE_LIMIT_PER_DAY="120"

# --- Supabase (leads, sugerencias y rate limit) ---------------
# Project Settings > API
# Usa la clave SECRETA (sb_secret_... o el antiguo service_role).
# Nunca la expongas en el navegador ni la subas al repositorio.
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_SECRET_KEY=""
# Opcional, solo si usas el cliente en el navegador:
SUPABASE_PUBLISHABLE_KEY=""

# --- Gmail (envío del libro y avisos) -------------------------
# Gmail NO usa "API key": usa una contraseña de aplicación de 16 caracteres
# (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_FROM_NAME="Diccionario IA"
# Correo donde quieres recibir aviso de cada lead (opcional)
LEADS_NOTIFY_EMAIL=""

# --- Analítica sin cookies (opcional) ------------------------
# Si defines el dominio, se carga Plausible. Déjalo vacío para no cargar nada.
PUBLIC_PLAUSIBLE_DOMAIN=""

# --- Seguridad del rate limit --------------------------------
# Cambia esta sal por una cadena larga y aleatoria en producción.
RATE_LIMIT_SALT=""